# ==============================================================================
# SmartHealth ID - Backend Environment Configuration
# ==============================================================================

# Application Security
SECRET_KEY=supersecretjwtkeychangeinproduction12345!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# 1. Supabase Cloud Database Connection (Recommended)
# ==============================================================================
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials:
#
# OPTION A: Supabase Connection Pooler - Session Mode (Port 5432) or Transaction Mode (Port 6543)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# OPTION B: Supabase Direct Connection (IPv6 compatible)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Examples:
# DATABASE_URL=postgresql://postgres.xyzprojectref:mypassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# 2. Supabase API Credentials (Optional - for Supabase Storage, Auth, Realtime)
# ==============================================================================
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# ==============================================================================
# 3. Local SQLite Fallback (For offline testing)
# ==============================================================================
# DATABASE_URL=sqlite:///./smarthealth.db
